{
  "name": "reclaim-desktop",
  "version": "1.0.0",
  "description": "Reclaim Windows Desktop Agent — System-level short-form content blocking",
  "main": "electron/main/index.js",
  "author": "Reclaim",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yashhackz360/Reclaim"
  },
  "scripts": {
    "start":       "electron .",
    "dev":         "nodemon --watch electron --exec electron .",
    "build":       "electron-builder --win",
    "build:nsis":  "electron-builder --win nsis",
    "build:port":  "electron-builder --win portable",
    "service:install": "node service/install.js",
    "service:remove":  "node service/remove.js",
    "test":        "jest"
  },
  "dependencies": {
    "electron-store":    "^8.1.0",
    "firebase-admin":    "^11.11.0",
    "node-windows":      "^1.0.0-beta.8",
    "node-notifier":     "^10.0.1",
    "axios":             "^1.6.5",
    "winston":           "^3.11.0"
  },
  "devDependencies": {
    "electron":          "^28.2.0",
    "electron-builder":  "^24.9.1",
    "nodemon":           "^3.0.3",
    "jest":              "^29.7.0"
  },
  "build": {
    "appId":       "app.reclaim.desktop",
    "productName": "Reclaim",
    "win": {
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick":            false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      { "from": "service/", "to": "service/", "filter": ["**/*"] }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
